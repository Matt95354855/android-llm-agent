# Exemple de configuration — noms de variables et valeurs non sensibles uniquement (D05).
# Copier en .env côté serveur ; ne jamais committer le .env réel.

# Accès à l'interface (T01). Générer une valeur longue et aléatoire.
PE_ACCESS_TOKEN=changez-moi

# Répertoire persistant (volume Runpod) : base, APK, profils Android, artefacts.
PE_DATA_DIR=/workspace/phone_emulator

# Base de données. SQLite par défaut ; PostgreSQL possible (postgresql+asyncpg://...).
PE_DATABASE_URL=sqlite+aiosqlite:////workspace/phone_emulator/control.db

# Backend des appareils : "emulator" (Android Emulator réel) ou "demo" (factice, signalé dans l'UI).
PE_DEVICE_BACKEND=emulator
PE_DEVICE_COUNT=4

# Profil Android Emulator
PE_ANDROID_SYSTEM_IMAGE=system-images;android-30;google_apis;x86_64
PE_EMULATOR_GPU=swiftshader_indirect

# Service modèle compatible OpenAI (vLLM ou SGLang), joignable uniquement côté serveur (L16).
PE_LLM_BASE_URL=http://127.0.0.1:8001/v1
PE_LLM_MODEL=Qwen/Qwen3.8-27B
PE_LLM_API_KEY=changez-moi
PE_LLM_MAX_CONCURRENCY=4
