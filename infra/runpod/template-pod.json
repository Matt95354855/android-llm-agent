{
  "name": "phone-emulator-pod",
  "imageName": "ghcr.io/matt95354855/phone_emulator-pod:0.1.0",
  "category": "CPU",
  "isServerless": false,
  "isPublic": false,
  "containerDiskInGb": 40,
  "volumeInGb": 150,
  "volumeMountPath": "/workspace",
  "ports": ["8000/http", "22/tcp"],
  "env": {
    "PE_ACCESS_TOKEN": "{{ RUNPOD_SECRET_pe_access_token }}",
    "PE_DEVICE_COUNT": "4",
    "PE_LLM_BASE_URL": "https://<pod-modele>-8001.proxy.runpod.net/v1",
    "PE_LLM_API_KEY": "{{ RUNPOD_SECRET_pe_llm_api_key }}",
    "PE_LLM_MODEL": "Qwen/Qwen3.8-27B"
  },
  "readme": "Quatre Android + service de contrôle + interface web. Nécessite /dev/kvm : lancer d'abord scripts/runpod_diag.sh sur le profil choisi."
}
